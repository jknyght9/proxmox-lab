# Proxmox Lab Bootstrap Configuration
#
# Minimal input required to bootstrap the lab. Everything else (cluster
# topology, storage pools, network bridges) is auto-discovered from
# Proxmox. Copy this file to bootstrap.yml and fill in your values.
#
# Usage:
#   cp bootstrap.yml.example bootstrap.yml
#   # Edit bootstrap.yml with your values
#   ./setup.sh

# =============================================================================
# Required
# =============================================================================

proxmox:
  ip: "192.168.1.100"          # IP of any Proxmox node (cluster auto-detected)
  password: "changeme"          # Root password (used once to create API token)

network:
  cidr: "192.168.1.0/24"       # Network CIDR for VMs and containers
  gateway: "192.168.1.1"       # Default gateway
  # bridge: "vmbr0"            # Optional: override auto-detected bridge
  # dns: "192.168.1.1"         # Optional: DNS server the Proxmox hosts should use
                                #   (and what purge resets resolv.conf to). Defaults to
                                #   network.gateway. Set explicitly on networks where the
                                #   gateway isn't a DNS server, or where 1.1.1.1/8.8.8.8
                                #   are blocked.

dns_suffix: "mylab.lan"        # Domain suffix for all services

# Optional: override auto-detected storage pools
# If omitted, bootstrap discovers available pools and picks the best option.
# storage:
#   templates: "nfs-templates"  # Storage for Packer template images (must support 'images' content)
#   runtime:   "local-lvm"      # Storage for running VMs and LXC containers
#   snippets:  "local"          # Storage for cloud-init vendor data (must support 'snippets' content)
#   vztmpl:    "local"          # Storage for downloaded LXC templates (must support 'vztmpl' content)
#   lxc:       "local-lvm"      # Storage for LXC container rootfs (block-level preferred)

# =============================================================================
# High Availability (optional — uncomment to enable keepalived VIPs)
# Requires: 3-node cluster. VIPs float between nodes for failover.
# =============================================================================

# ha_dns_enabled: true
# ha_dns_vip: "192.168.1.3/24"       # Virtual IP for DNS failover
# ha_dns_vrrp_router_id: 51          # Unique VRRP ID (1-255, must not conflict)
# ha_dns_vrrp_password: "pihole-ha"  # VRRP auth password (max 8 chars)
# ha_traefik_enabled: true
# ha_traefik_vip: "192.168.1.100/24" # Virtual IP for Traefik/services failover
# ha_traefik_vrrp_router_id: 53
# ha_traefik_vrrp_password: "traefik-ha"

# =============================================================================
# Roaming Profiles (optional — maps network drive on domain login)
# Requires: Samba AD deployed, file server with SMB share
# =============================================================================

# profile_server: "truenas.mylab.lan"  # File server IP or FQDN
# profile_share: "profiles"            # SMB share name for user profiles
# profile_drive_letter: "P"            # Drive letter to map (Windows)

# =============================================================================
# NAS Servers (optional — AD domain join, profile shares)
# Supports TrueNAS SCALE and Synology DSM 7.x
# API keys are stored in Vault after first use
# =============================================================================

# nas_servers:
#   - name: "truenas-01"               # Friendly name (used as Vault key)
#     type: "truenas"                   # "truenas" or "synology"
#     address: "192.168.1.50"           # Management IP or FQDN
#     api_key: ""                       # TrueNAS: API key from UI
#                                       # Synology: not needed (uses AD join creds)
#   - name: "synology-01"
#     type: "synology"
#     address: "192.168.1.51"
#     admin_user: "admin"               # Synology DSM admin (for API auth)
#     admin_password: ""                # Synology DSM admin password

# =============================================================================
# UniFi Controller (optional — network device inventory in Netbox)
# Requires: UniFi Controller/OS accessible on network, API key generated
# API key: Settings → Control Plane → API Key (UniFi OS 4.x+)
# =============================================================================

# unifi_address: "192.168.1.1"          # UniFi Controller IP or FQDN
# unifi_api_key: ""                      # API key (Settings → Integrations)
# unifi_site: "default"                  # Site name (default for most setups)

# How often the periodic netbox-sync Nomad job re-scrapes UniFi.
# Cron syntax. Defaults: every 6 hours, UTC. Only used when both
# Netbox and UniFi are configured.
# netbox_sync_cron:     "0 */6 * * *"
# netbox_sync_timezone: "UTC"
