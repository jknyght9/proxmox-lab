# Proxmox Lab Bootstrap Configuration
#
# Minimal input required to bootstrap the lab. Everything else (cluster
# topology, storage pools, network bridges) is auto-discovered from
# Proxmox. Copy this file to bootstrap.yml and fill in your values.
#
# Usage:
#   cp bootstrap.yml.example bootstrap.yml
#   # Edit bootstrap.yml with your values
#   ./setup.sh

# =============================================================================
# Required
# =============================================================================

proxmox:
  ip: "192.168.1.100"          # IP of any Proxmox node (cluster auto-detected)
  password: "changeme"          # Root password (used once to create API token)

network:
  cidr: "192.168.1.0/24"       # Network CIDR for VMs and containers
  gateway: "192.168.1.1"       # Default gateway
  # bridge: "vmbr0"            # Optional: override auto-detected bridge
  # dns: "192.168.1.1"         # Optional: DNS server the Proxmox hosts should use
                                #   (and what purge resets resolv.conf to). Defaults to
                                #   network.gateway. Set explicitly on networks where the
                                #   gateway isn't a DNS server, or where 1.1.1.1/8.8.8.8
                                #   are blocked.
  # dns_use_dot: true           # Pi-hole/Unbound upstream uses DNS-over-TLS to
                                #   Cloudflare/Quad9 by default. Set to false on
                                #   networks that block outbound 853/tcp — Unbound
                                #   will forward to plain UDP/53 against network.dns
                                #   instead.

dns_suffix: "mylab.lan"        # Domain suffix for all services

# Internal service DNS records backend: "pihole" (default) or "unifi".
#   "unifi" requires unifi_address + unifi_api_key (configured below) —
#   that writer reconciles records against the UniFi controller.
#
# This also decides what the lab's hosts use as their RESOLVER at the end of a
# deploy. With "pihole" (default) the PVE hosts and Nomad VMs are pointed at the
# lab Pi-hole, which holds the generated records. With "unifi" they are pointed
# at network.dns (else network.gateway) instead — otherwise every query would go
# to a Pi-hole holding none of them.
#
# The two writers also differ: the Pi-hole writer REPLACES dns.hosts wholesale,
# so records added by hand in the Pi-hole UI are lost on the next apply. The
# UniFi writer is scoped — it tracks what it created and prunes only that, so
# manual controller records survive.
#
# The Pi-hole LXCs are deployed either way; with "unifi" they are simply not the
# record target.
# dns_backend: "pihole"

# Storage configuration:
#   - Top half (templates, runtime, snippets, vztmpl, lxc) overrides
#     Proxmox-side storage pool auto-detection.
#   - Bottom half (cluster_state, snapshots) configures NAS-backed pooled
#     storage for stateful Nomad services. cluster_state.nas REQUIRES a
#     matching entry in `nas_servers` below (and that entry's `pool`).
#     This is what replaces GlusterFS; deploys refuse to start stateful
#     services without it.
# storage:
#   # --- Proxmox storage pools (optional overrides) ---
#   templates: "nfs-templates"  # Storage for Packer template images (must support 'images' content)
#   runtime:   "local-lvm"      # Storage for running VMs and LXC containers
#   snippets:  "local"          # Storage for cloud-init vendor data (must support 'snippets' content)
#   vztmpl:    "local"          # Storage for downloaded LXC templates (must support 'vztmpl' content)
#   lxc:       "local-lvm"      # Storage for LXC container rootfs (block-level preferred)
#
#   # --- NAS-backed cluster storage (required for stateful services) ---
#   cluster_state:
#     nas: "nas01"              # Name of an entry in nas_servers (below)
#     dataset_root: "nomad"     # → creates <pool>/nomad/<service> on the NAS
#     allow_hosts: ""           # CIDR; blank = use network.cidr
#
#   # --- Snapshot + replication policy (replaces old `backup:` block) ---
#   snapshots:
#     schedule: "hourly"                 # hourly | daily | both
#     retention_hourly: 96
#     retention_daily: 30
#     retention_monthly: 12
#     # replicate_to:                    # OPTIONAL — ZFS replication target
#     #   nas: "nas02"                   # different NAS for offsite
#     #   pool: "pool_backup"            # or different pool on same NAS

# =============================================================================
# High Availability (optional — uncomment to enable keepalived VIPs)
# Requires: 3-node cluster. VIPs float between nodes for failover.
# =============================================================================

# ha_dns_enabled: true
# ha_dns_vip: "192.168.1.3/24"       # Virtual IP for DNS failover
# ha_dns_vrrp_router_id: 51          # Unique VRRP ID (1-255, must not conflict)
# ha_dns_vrrp_password: "pihole-ha"  # VRRP auth password (max 8 chars)
# ha_traefik_enabled: true
# ha_traefik_vip: "192.168.1.100/24" # Virtual IP for Traefik/services failover
# ha_traefik_vrrp_router_id: 53
# ha_traefik_vrrp_password: "traefik-ha"

# =============================================================================
# Roaming Profiles (optional — maps network drive on domain login)
# Requires: Samba AD deployed, file server with SMB share
# =============================================================================

# profile_server: "truenas.mylab.lan"  # File server IP or FQDN
# profile_share: "profiles"            # SMB share name for user profiles
# profile_drive_letter: "P"            # Drive letter to map (Windows)

# =============================================================================
# NAS Servers (optional — AD domain join, profile shares)
# Supports TrueNAS SCALE and Synology DSM 7.x
# API keys are stored in Vault after first use
# =============================================================================

# nas_servers:
#   - name: "truenas-01"               # Friendly name (used as Vault key)
#     type: "truenas"                   # "truenas" or "synology"
#     address: "192.168.1.50"           # Management IP or FQDN
#     api_key: ""                       # TrueNAS: API key from UI
#                                       # Synology: not needed (uses AD join creds)
#     pool: "pool_data"                 # REQUIRED if this NAS is referenced by
#                                       # any storage role (storage.cluster_state.nas,
#                                       # provides_profiles, etc.). ZFS pool name.
#     # --- Roaming-profile fields (optional; omit to skip profile setup on this NAS) ---
#     # provides_profiles: true         # Opt-in: auto-create dataset, share, ACLs, per-user folders
#     # profile_dataset: "pool/profiles" # ZFS dataset to create (no /mnt/ prefix). Required if provides_profiles.
#     # profile_ad_group: "Domain Users" # AD group granted traverse on parent (default: Domain Users)
#   - name: "synology-01"
#     type: "synology"
#     address: "192.168.1.51"
#     admin_user: "admin"               # Synology DSM admin (for API auth)
#     admin_password: ""                # Synology DSM admin password

# =============================================================================
# Resource pool + backup schedule (optional)
# =============================================================================
# resource_pool names a Proxmox resource pool that every guest this project
# creates joins automatically (Terraform sets pool_id on each VM and LXC). That
# gives the cluster one handle for "everything proxmox-lab deployed" — which is
# what the backup job targets, instead of a VMID list that goes stale every
# time the deployment is rebuilt with different IDs.
#
# Leave resource_pool empty and no pool is created or referenced.

# resource_pool: "proxmox-lab"

# pve_backup creates a cluster backup job scoped to that pool. This is the
# Proxmox-level backup of VM and LXC *images* — distinct from:
#   - storage.snapshots above, which is ZFS snapshots of Nomad service state
#     on the NAS, and
#   - the deprecated `backup:` block further down, which was the old Nomad
#     tar+pg_dump job and is ignored.
#
# storage is any PVE storage with content=backup — a PBS datastore (dedup,
# incremental, verifiable) or a plain NFS/CIFS share (full copies every run).
#
# schedule is a systemd calendar event: "03:00" or "sat 02:00" or
# "*-*-* 03:00:00". NOT "daily 03:00" — that is rejected as invalid.
#
# retention is optional. Omit it and the storage's own policy applies, which is
# what you want with PBS (its prune job already owns retention). Set keep_* to
# have the job carry its own prune-backups policy instead.
#
# Setting enabled: false removes a job this project previously created, so
# turning it off actually stops backups rather than orphaning a schedule.

# pve_backup:
#   enabled: true
#   storage: "pbs-main"          # PVE storage id with content=backup
#   schedule: "03:00"            # systemd calendar event
#   mode: "snapshot"             # snapshot | suspend | stop
#   retention:                   # optional — omit to inherit the storage policy
#     keep_daily: 7
#     keep_weekly: 4
#     keep_monthly: 6

# =============================================================================
# Traefik certificate resolver (optional — publicly trusted TLS)
# =============================================================================
# Omit this block entirely and Traefik keeps using the lab's internal Vault
# PKI: a `*.<dns_suffix>` wildcard minted at deploy time. Browsers warn unless
# you install the internal root CA, but there is no external dependency and
# nothing about the lab is published anywhere.
#
# Set it to have Traefik obtain a publicly trusted wildcard from an ACME CA
# instead, validated over DNS-01. DNS-01 is the only challenge that works for
# internal-only services (no inbound reachability needed) and the only one
# that can issue wildcards.
#
# Vault cannot do this itself. Vault PKI can *serve* ACME to internal clients,
# but it has no ACME client, so it can never produce a publicly trusted cert.
# Traefik is the ACME client here.
#
# `credentials` is passed through verbatim as environment variables, so any
# provider Traefik supports works without a code change — only the key names
# differ. See https://doc.traefik.io/traefik/https/acme/#providers
#
#   cloudflare -> CF_DNS_API_TOKEN
#                 Needs BOTH Zone:DNS:Edit AND Zone:Zone:Read — the provider
#                 looks the zone up from the domain, so a DNS:Edit-only token
#                 fails. Cloudflare's "Edit zone DNS" template grants both;
#                 scope it to the one zone. No zone ID is required.
#                 Optional CF_ZONE_API_TOKEN splits the read half off.
#   route53    -> AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
#                 AWS_HOSTED_ZONE_ID
#   azuredns   -> AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_TENANT_ID,
#                 AZURE_SUBSCRIPTION_ID
#
# Credentials are written to Vault at secret/traefik-acme and injected into
# the job at runtime — they never appear in a jobspec or a tracked file.
#
# RATE LIMITS: Traefik runs as a system job, so every Nomad node keeps its own
# acme.json (persisted at /var/lib/traefik-acme on the host) and requests its
# own cert. Let's Encrypt allows 50 certs/week per registered domain but only
# 5 duplicate certs/week for an identical name set — a 3-node cluster is fine
# steady-state, but repeated redeploys will exhaust it. Use staging: true
# while iterating; those certs are untrusted but the limits are far looser.
#
# PRIVACY: publicly issued certs are published in Certificate Transparency
# logs. A wildcard logs only `*.<dns_suffix>`, revealing no service names,
# which is why this issues a wildcard as the entrypoint default rather than
# per-service certs.

# traefik_acme:
#   enabled: true
#   provider: "cloudflare"            # Traefik DNS provider code
#   email: "admin@example.com"        # ACME account email
#   staging: false                    # true => LE staging (untrusted, loose limits)
#   # ca_server: ""                   # override the ACME directory URL entirely
#   # dns_resolvers: "1.1.1.1:53,8.8.8.8:53"   # used to verify the TXT record
#   credentials:
#     CF_DNS_API_TOKEN: ""

# =============================================================================
# UniFi Controller (optional — network device inventory in Netbox)
# Requires: UniFi Controller/OS accessible on network, API key generated
# API key: Settings → Control Plane → API Key (UniFi OS 4.x+)
# =============================================================================

# unifi_address: "192.168.1.1"          # UniFi Controller IP or FQDN
# unifi_api_key: ""                      # API key (Settings → Integrations)
# unifi_site: "default"                  # Site name (default for most setups)

# How often the periodic netbox-sync Nomad job re-scrapes UniFi.
# Cron syntax. Defaults: every 6 hours, UTC. Only used when both
# Netbox and UniFi are configured.
# netbox_sync_cron:     "0 */6 * * *"
# netbox_sync_timezone: "UTC"


# =============================================================================
# Tailscale Subnet Routers (optional — every Nomad node joins the tailnet
# and advertises the lab subnet so remote tailnet clients can reach lab IPs)
# =============================================================================
# Generate auth_key at https://login.tailscale.com/admin/settings/keys
# (Reusable: yes; Pre-authorized: yes; Expiry: 90 days max — rotate before).
# After deploy, approve the advertised routes in the Tailscale admin UI:
# Machines → <node> → Edit route settings → enable the subnet.

# tailscale:
#   auth_key:         "tskey-auth-..."     # required
#   advertise_routes: "10.10.0.0/24"       # CSV; defaults to network.cidr if blank
