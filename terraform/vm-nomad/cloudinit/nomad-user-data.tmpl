#cloud-config
# Bootstrap-only cloud-init for Nomad cluster VMs.
# Sets up hostname, users, SSH keys, and base packages.
# All runtime configuration (Nomad HCL, Vault WIF, keepalived, certs)
# is managed by Terraform null_resource provisioners so it can be
# reconfigured with `terraform apply` without recreating VMs.

hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: labadmin
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_authorized_keys}
  - name: root
    ssh_authorized_keys:
      - ${ssh_authorized_keys}

packages: [curl, jq, socat, ca-certificates]

write_files:
  # Persistent IP forwarding for the Tailscale subnet router. Even if
  # tailscale isn't deployed yet, having this on by default is harmless
  # (kernel routing only happens when something actually forwards). We
  # enable it once at first boot via cloud-init so it survives reboots
  # without depending on the Nomad job's prestart task.
  - path: /etc/sysctl.d/99-tailscale-forward.conf
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1

  # Override the stock /etc/cloud/templates/hosts.debian.tmpl so cloud-init
  # bakes the internal service FQDNs into /etc/hosts on every boot. Without
  # this, manage_etc_hosts:true regenerates /etc/hosts from the stock
  # template at boot, wiping any manual entries — and Nomad client workloads
  # (plus Vault's container) can't resolve vault/auth/traefik while
  # resolv.conf still points at the network gateway during bootstrap.
  - path: /etc/cloud/templates/hosts.debian.tmpl
    permissions: "0644"
    content: |
      ${indent(6, hosts_template_content)}

runcmd:
  - mkdir -p /opt/nomad/data
  - chown -R nomad:nomad /opt/nomad || true
  # Apply the IP-forward sysctl now so we don't need a reboot
  - sysctl --system >/dev/null 2>&1 || true
  - |
    bash -lc '
      systemctl enable --now systemd-timesyncd || true
      systemctl restart systemd-timesyncd || true
    '
  - |
    bash -lc '
      echo "[time] waiting for NTP sync..."
      for i in {1..30}; do
        if timedatectl show -p NTPSynchronized --value 2>/dev/null | grep -qi yes; then
          timedatectl status || true
          break
        fi
        sleep 2
      done
    '
  - |
    bash -lc '
      export HOME=/root; cd /root; echo "HOME=$HOME PWD=$PWD"
      command -v ~/.acme.sh/acme.sh >/dev/null || (curl -fsSL https://get.acme.sh | sh -s email=admin@${dns_postfix})
    '
  # Only enable nomad — Terraform starts it after GlusterFS is configured
  - systemctl enable nomad
